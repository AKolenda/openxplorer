<!--
  One setting (src/settings_page/row.rs): its one-line title with an ⓘ
  that opens its details, and under it a live status line where the
  setting has one (such as the app that opens ZIP files), on the left;
  its compact controls on the right, or below the text in a narrow window.
-->
<interface>
  <requires lib="gtk" version="4.14"/>
  <template class="OxSettingRow" parent="GtkBox">
    <property name="spacing">16</property>
    <style>
      <class name="setting-row"/>
    </style>
    <child>
      <object class="GtkBox" id="texts">
        <property name="orientation">vertical</property>
        <property name="hexpand">true</property>
        <property name="valign">center</property>
        <child>
          <!-- A grid, not a box: a box lines the title and the ⓘ up by
               their baselines for one width and not for another, and GTK
               refuses a height that changes so. -->
          <object class="GtkGrid" id="title_line">
            <property name="column-spacing">4</property>
            <child>
              <object class="GtkLabel" id="title_label">
                <property name="xalign">0</property>
                <property name="valign">center</property>
                <property name="wrap">true</property>
                <style>
                  <class name="setting-title"/>
                </style>
                <layout>
                  <property name="column">0</property>
                  <property name="row">0</property>
                </layout>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="GtkLabel" id="description_label">
            <property name="xalign">0</property>
            <property name="wrap">true</property>
            <style>
              <class name="setting-description"/>
            </style>
          </object>
        </child>
      </object>
    </child>
    <child>
      <object class="GtkBox" id="control_slot">
        <property name="valign">center</property>
        <property name="spacing">8</property>
        <style>
          <class name="setting-controls"/>
        </style>
      </object>
    </child>
  </template>
</interface>
