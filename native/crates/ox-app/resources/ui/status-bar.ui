<!-- The status bar (footer.statusbar in v2.0.0:desktop/ui/index.html), as
     Windows 11 File Explorer's: the item count, a divider and the
     selection, the type-to-select hint, then at the right the build,
     "Check for updates" and the two view buttons
     (src/window/status_bar.rs). -->
<interface>
  <requires lib="gtk" version="4.14"/>
  <template class="OxStatusBar" parent="GtkBox">
    <property name="spacing">18</property>
    <style>
      <class name="statusbar"/>
    </style>
    <child>
      <!-- The count, Explorer's thin divider and the selection, 10 px
           apart. -->
      <object class="GtkBox">
        <property name="spacing">10</property>
        <style>
          <class name="status-counts"/>
        </style>
        <child>
          <!-- #status-count -->
          <object class="GtkLabel" id="count">
            <!-- Screen readers hear the item count and the type-to-select
                 hint change (the live regions of index.html). -->
            <property name="accessible-role">status</property>
            <property name="label" translatable="yes">Ready</property>
            <property name="xalign">0</property>
          </object>
        </child>
        <child>
          <!-- Explorer's thin line between the count and the selection, shown
               while something is selected. -->
          <object class="GtkSeparator" id="selection_divider">
            <property name="orientation">vertical</property>
            <property name="visible">false</property>
            <property name="valign">center</property>
            <style>
              <class name="selection-divider"/>
            </style>
          </object>
        </child>
        <child>
          <!-- #status-selected -->
          <object class="GtkLabel" id="selection">
            <property name="xalign">0</property>
            <property name="ellipsize">end</property>
          </object>
        </child>
      </object>
    </child>
    <child>
      <object class="GtkLabel" id="typeahead_hint">
        <property name="accessible-role">status</property>
        <property name="xalign">0</property>
        <property name="ellipsize">end</property>
        <style>
          <class name="typeahead-hint"/>
        </style>
      </object>
    </child>
    <child>
      <object class="GtkBox">
        <property name="hexpand">true</property>
      </object>
    </child>
    <child>
      <!-- Shown while the folder cannot be watched for changes. -->
      <object class="GtkLabel" id="watch_state">
        <property name="visible">false</property>
        <property name="label" translatable="yes">Not updated live</property>
      </object>
    </child>
    <child>
      <!-- #status-mode: the build, which a compact window hides. -->
      <object class="GtkLabel" id="build">
        <property name="ellipsize">end</property>
        <style>
          <class name="status-mode"/>
        </style>
      </object>
    </child>
    <child>
      <!-- #check-updates: the Software updates dialog. It shows, with
           "Update available" or "Restart to finish updating", only while
           a check found something that needs the user. -->
      <object class="GtkButton" id="check_updates_button">
        <property name="valign">center</property>
        <accessibility>
          <property name="label" translatable="yes">Check for updates</property>
        </accessibility>
        <property name="child">
          <object class="GtkBox">
            <property name="spacing">6</property>
            <child>
              <object class="GtkImage" id="update_glyph">
                <property name="accessible-role">presentation</property>
              </object>
            </child>
            <child>
              <object class="GtkLabel" id="update_label"/>
            </child>
          </object>
        </property>
      </object>
    </child>
    <child>
      <object class="GtkButton" id="details_view_button">
        <property name="tooltip-text" translatable="yes">Details view</property>
        <property name="valign">center</property>
        <accessibility>
          <property name="label" translatable="yes">Details view</property>
        </accessibility>
      </object>
    </child>
    <child>
      <object class="GtkButton" id="icons_view_button">
        <property name="tooltip-text" translatable="yes">Large icons</property>
        <property name="valign">center</property>
        <accessibility>
          <property name="label" translatable="yes">Large icons</property>
        </accessibility>
      </object>
    </child>
  </template>
</interface>
