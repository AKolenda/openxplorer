<!-- The status bar (footer.statusbar in v2.0.0:desktop/ui/index.html): the item
     count, the selection and the type-to-select hint, then at the right
     the build, "Check for updates" and the two view buttons
     (src/window/status_bar.rs). -->
<interface>
  <requires lib="gtk" version="4.14"/>
  <template class="OxStatusBar" parent="GtkBox">
    <property name="spacing">18</property>
    <style>
      <class name="statusbar"/>
    </style>
    <child>
      <!-- #status-count -->
      <object class="GtkLabel" id="count">
        <!-- Screen readers hear the item count and the type-to-select
             hint change (the live regions of index.html). -->
        <property name="accessible-role">status</property>
        <property name="label" translatable="yes">Ready</property>
        <property name="xalign">0</property>
      </object>
    </child>
    <child>
      <!-- #status-selected -->
      <object class="GtkLabel" id="selection">
        <property name="xalign">0</property>
        <property name="ellipsize">end</property>
      </object>
    </child>
    <child>
      <object class="GtkLabel" id="typeahead_hint">
        <property name="accessible-role">status</property>
        <property name="xalign">0</property>
        <property name="ellipsize">end</property>
        <style>
          <class name="typeahead-hint"/>
        </style>
      </object>
    </child>
    <child>
      <object class="GtkBox">
        <property name="hexpand">true</property>
      </object>
    </child>
    <child>
      <!-- Shown while the folder's drive is mounted read-only. -->
      <object class="GtkLabel" id="drive_state">
        <property name="visible">false</property>
        <property name="label" translatable="yes">Read-only drive</property>
      </object>
    </child>
    <child>
      <!-- Shown while the folder cannot be watched for changes. -->
      <object class="GtkLabel" id="watch_state">
        <property name="visible">false</property>
        <property name="label" translatable="yes">Not updated live</property>
      </object>
    </child>
    <child>
      <!-- The current volume's free space and how full it is (Dolphin's
           space info); a click offers the disk-usage tools. -->
      <object class="GtkBox" id="free_space_box">
        <property name="visible">false</property>
        <property name="spacing">8</property>
        <child>
          <object class="GtkLabel" id="free_space"/>
        </child>
        <child>
          <object class="GtkProgressBar" id="capacity">
            <property name="valign">center</property>
            <style>
              <class name="capacity"/>
            </style>
          </object>
        </child>
      </object>
    </child>
    <child>
      <!-- #status-mode: the build, which a compact window hides. -->
      <object class="GtkLabel" id="build">
        <property name="ellipsize">end</property>
        <style>
          <class name="status-mode"/>
        </style>
      </object>
    </child>
    <child>
      <!-- #check-updates: the Software updates dialog. -->
      <object class="GtkButton" id="check_updates_button">
        <property name="valign">center</property>
        <accessibility>
          <property name="label" translatable="yes">Check for updates</property>
        </accessibility>
      </object>
    </child>
    <child>
      <!-- Dolphin's zoom slider: the icon size, shown in the icon view. -->
      <object class="GtkScale" id="zoom_slider">
        <property name="visible">false</property>
        <property name="valign">center</property>
        <property name="draw-value">false</property>
        <property name="tooltip-text" translatable="yes">Icon size</property>
        <style>
          <class name="zoom-slider"/>
        </style>
        <accessibility>
          <property name="label" translatable="yes">Icon size</property>
        </accessibility>
      </object>
    </child>
    <child>
      <object class="GtkButton" id="details_view_button">
        <property name="tooltip-text" translatable="yes">Details view</property>
        <property name="valign">center</property>
        <accessibility>
          <property name="label" translatable="yes">Details view</property>
        </accessibility>
      </object>
    </child>
    <child>
      <object class="GtkButton" id="icons_view_button">
        <property name="tooltip-text" translatable="yes">Large icons</property>
        <property name="valign">center</property>
        <accessibility>
          <property name="label" translatable="yes">Large icons</property>
        </accessibility>
      </object>
    </child>
  </template>
</interface>
