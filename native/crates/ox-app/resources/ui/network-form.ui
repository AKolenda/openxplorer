<?xml version="1.0" encoding="UTF-8"?>
<!-- SPDX-License-Identifier: AGPL-3.0-only -->
<!--
  A network dialog with fields: `.modal` of desktop/ui/style.css (the
  title, the message, the fields, `.modal-note`, `.modal-error` and
  `.modal-actions`) as `showModal` in desktop/ui/app.js builds it for Map
  network location and Sign out, refined to WinUI's ContentDialog
  (native/docs/ui-spec.md §4.11). The window has no title bar of its own:
  its title is the heading, and the whole surface is a window handle, so it
  can be dragged where the desktop does not attach it to its window.
  src/dialogs/network_form.rs adds the fields.
-->
<interface>
  <requires lib="gtk" version="4.14"/>
  <template class="OxNetworkFormDialog" parent="GtkWindow">
    <property name="modal">true</property>
    <property name="resizable">false</property>
    <property name="destroy-with-parent">true</property>
    <property name="hide-on-close">false</property>
    <!-- .modal{width:510px} -->
    <property name="default-width">510</property>
    <property name="titlebar">
      <object class="GtkBox">
        <property name="visible">false</property>
      </object>
    </property>
    <property name="accessible-role">dialog</property>
    <style>
      <class name="ox"/>
      <class name="ox-dialog"/>
    </style>
    <property name="child">
      <object class="GtkWindowHandle">
        <property name="child">
          <object class="GtkBox">
            <property name="orientation">vertical</property>
            <child>
              <object class="GtkBox" id="content">
                <property name="orientation">vertical</property>
                <style>
                  <class name="dialog-content"/>
                </style>
                <child>
                  <object class="GtkLabel" id="title_label">
                    <property name="xalign">0</property>
                    <property name="wrap">true</property>
                    <property name="wrap-mode">word-char</property>
                    <property name="max-width-chars">40</property>
                    <style>
                      <class name="dialog-title"/>
                    </style>
                  </object>
                </child>
                <child>
                  <!-- The message keeps its line breaks, as `white-space:
                       pre-wrap` did. -->
                  <object class="GtkLabel" id="message_label">
                    <property name="xalign">0</property>
                    <property name="wrap">true</property>
                    <property name="wrap-mode">word-char</property>
                    <property name="max-width-chars">60</property>
                    <style>
                      <class name="dialog-message"/>
                    </style>
                  </object>
                </child>
                <child>
                  <object class="GtkBox" id="fields">
                    <property name="orientation">vertical</property>
                    <style>
                      <class name="dialog-fields"/>
                    </style>
                  </object>
                </child>
                <child>
                  <object class="GtkLabel" id="error_label">
                    <property name="visible">false</property>
                    <property name="xalign">0</property>
                    <property name="wrap">true</property>
                    <property name="wrap-mode">word-char</property>
                    <property name="max-width-chars">60</property>
                    <property name="selectable">true</property>
                    <property name="accessible-role">alert</property>
                    <style>
                      <class name="dialog-error"/>
                    </style>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="GtkBox">
                <property name="spacing">8</property>
                <style>
                  <class name="dialog-actions"/>
                </style>
                <child>
                  <object class="GtkButton" id="cancel_button">
                    <property name="label">Cancel</property>
                    <property name="hexpand">true</property>
                    <property name="halign">end</property>
                    <style>
                      <class name="bordered"/>
                    </style>
                  </object>
                </child>
                <child>
                  <object class="GtkButton" id="confirm_button">
                    <style>
                      <class name="accent"/>
                    </style>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </property>
      </object>
    </property>
  </template>
</interface>
