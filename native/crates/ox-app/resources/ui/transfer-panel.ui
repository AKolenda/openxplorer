<?xml version="1.0" encoding="UTF-8"?>
<!-- SPDX-License-Identifier: AGPL-3.0-only -->
<!--
  The transfer panel, `#transfer` of v2.0.0:desktop/ui/index.html: the glyph of
  the kind of write, what the operation is doing above its progress bar,
  the current file's bar while a file is copied, and Cancel.
  It floats above the status bar between the sidebar and the details pane
  (native/docs/ui-spec.md §4.15, "Transfer"). src/window/transfer_panel.rs
  sets the glyph and handles Cancel.
-->
<interface>
  <requires lib="gtk" version="4.14"/>
  <template class="OxTransferPanel" parent="GtkBox">
    <property name="visible">false</property>
    <property name="valign">end</property>
    <property name="spacing">12</property>
    <style>
      <class name="transfer"/>
    </style>
    <child>
      <object class="GtkImage" id="glyph">
        <property name="accessible-role">presentation</property>
      </object>
    </child>
    <child>
      <object class="GtkBox">
        <property name="orientation">vertical</property>
        <property name="hexpand">true</property>
        <property name="spacing">8</property>
        <child>
          <object class="GtkLabel" id="status_label">
            <property name="xalign">0</property>
            <property name="ellipsize">end</property>
            <property name="accessible-role">status</property>
            <style>
              <class name="transfer-label"/>
            </style>
          </object>
        </child>
        <child>
          <object class="GtkProgressBar" id="progress_bar">
            <accessibility>
              <property name="label" translatable="yes">Operation progress</property>
            </accessibility>
          </object>
        </child>
        <child>
          <object class="GtkProgressBar" id="file_bar">
            <property name="visible">false</property>
            <accessibility>
              <property name="label" translatable="yes">Current file progress</property>
            </accessibility>
            <style>
              <class name="transfer-file"/>
            </style>
          </object>
        </child>
      </object>
    </child>
    <child>
      <object class="GtkButton" id="cancel_button">
        <property name="label" translatable="yes">Cancel</property>
        <property name="valign">center</property>
        <style>
          <class name="bordered"/>
        </style>
      </object>
    </child>
  </template>
</interface>
