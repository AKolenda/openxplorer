<?xml version="1.0" encoding="UTF-8"?>
<!-- SPDX-License-Identifier: AGPL-3.0-only -->
<!--
  "Software updates": `updatesDialog` of desktop/ui/app.js in the app's
  modal dialog frame (`.modal` of desktop/ui/style.css, refined to WinUI's
  ContentDialog, native/docs/ui-spec.md §4.11). The installed and
  available versions, a live status line, what updates a build that cannot
  install itself, then Close, Check again, Install update… and Restart
  now. src/update/dialog.rs shows and enables the buttons.
-->
<interface>
  <requires lib="gtk" version="4.14"/>
  <template class="OxUpdateDialog" parent="GtkWindow">
    <property name="title">Software updates</property>
    <property name="modal">true</property>
    <property name="resizable">false</property>
    <property name="destroy-with-parent">true</property>
    <property name="default-width">510</property>
    <property name="titlebar">
      <object class="GtkBox">
        <property name="visible">false</property>
      </object>
    </property>
    <property name="accessible-role">dialog</property>
    <style>
      <class name="ox"/>
      <class name="ox-dialog"/>
    </style>
    <property name="child">
      <object class="GtkWindowHandle">
        <property name="child">
          <object class="GtkBox">
            <property name="orientation">vertical</property>
            <child>
              <!-- The body scrolls when the dialog would be taller than its
                   window (src/modal.rs); otherwise it is as tall as its content. -->
              <object class="GtkScrolledWindow" id="scroller">
                <property name="hscrollbar-policy">never</property>
                <property name="propagate-natural-width">true</property>
                <property name="propagate-natural-height">true</property>
                <property name="vexpand">true</property>
                <property name="child">
                  <object class="GtkBox">
                    <property name="orientation">vertical</property>
                    <style>
                      <class name="dialog-content"/>
                    </style>
                    <child>
                      <object class="GtkLabel">
                        <property name="label">Software updates</property>
                        <property name="xalign">0</property>
                        <style>
                          <class name="dialog-title"/>
                        </style>
                      </object>
                    </child>
                    <child>
                      <!-- #update-versions -->
                      <object class="GtkLabel" id="versions_label">
                        <property name="xalign">0</property>
                        <property name="wrap">true</property>
                        <property name="selectable">true</property>
                        <property name="focusable">false</property>
                        <style>
                          <class name="dialog-message"/>
                        </style>
                      </object>
                    </child>
                    <child>
                      <!-- #update-status: role="status" aria-live="polite". -->
                      <object class="GtkLabel" id="status_label">
                        <property name="xalign">0</property>
                        <property name="wrap">true</property>
                        <property name="wrap-mode">word-char</property>
                        <property name="max-width-chars">60</property>
                        <property name="focusable">true</property>
                        <property name="accessible-role">status</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel" id="hint_label">
                        <property name="visible">false</property>
                        <property name="xalign">0</property>
                        <property name="wrap">true</property>
                        <property name="max-width-chars">60</property>
                        <style>
                          <class name="dialog-hint"/>
                        </style>
                      </object>
                    </child>
                  </object>
                </property>
              </object>
            </child>
            <child>
              <object class="GtkBox">
                <style>
                  <class name="dialog-actions"/>
                </style>
                <child>
                  <object class="GtkBox">
                    <property name="hexpand">true</property>
                    <property name="halign">end</property>
                    <property name="spacing">8</property>
                    <child>
                      <object class="GtkButton" id="close_button">
                        <property name="label">Close</property>
                        <style>
                          <class name="bordered"/>
                          <class name="dialog-button"/>
                        </style>
                      </object>
                    </child>
                    <child>
                      <object class="GtkButton" id="check_button">
                        <property name="label">Check again</property>
                        <style>
                          <class name="bordered"/>
                          <class name="dialog-button"/>
                        </style>
                      </object>
                    </child>
                    <child>
                      <object class="GtkButton" id="install_button">
                        <property name="label">Install update…</property>
                        <property name="visible">false</property>
                        <style>
                          <class name="accent"/>
                          <class name="dialog-button"/>
                        </style>
                      </object>
                    </child>
                    <child>
                      <object class="GtkButton" id="restart_button">
                        <property name="label">Restart now</property>
                        <property name="visible">false</property>
                        <style>
                          <class name="accent"/>
                          <class name="dialog-button"/>
                        </style>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </property>
      </object>
    </property>
  </template>
</interface>
