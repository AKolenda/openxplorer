<?xml version="1.0" encoding="UTF-8"?>
<!-- SPDX-License-Identifier: AGPL-3.0-only -->
<!--
  A modal dialog window: the app's one dialog frame (dialog-frame.ui) in a
  window of its own. The window has no title bar of its own; its title is
  the heading, and the whole surface is a window handle, so it can be
  dragged where the desktop does not attach it to its window.
  src/dialog/window.rs adds the fields and buttons.
-->
<interface>
  <requires lib="gtk" version="4.14"/>
  <template class="OxDialog" parent="GtkWindow">
    <property name="modal">true</property>
    <property name="resizable">false</property>
    <property name="destroy-with-parent">true</property>
    <property name="hide-on-close">false</property>
    <!-- .modal{width:510px}, less the 24-pixel padding on each side. -->
    <property name="default-width">510</property>
    <property name="titlebar">
      <object class="GtkBox">
        <property name="visible">false</property>
      </object>
    </property>
    <property name="accessible-role">dialog</property>
    <style>
      <class name="ox"/>
      <class name="ox-dialog"/>
    </style>
    <property name="child">
      <object class="GtkWindowHandle">
        <property name="child">
          <!-- The window is the dialog for assistive technologies, so the
               frame in it is only a group. -->
          <object class="OxDialogFrame" id="frame">
            <property name="accessible-role">group</property>
          </object>
        </property>
      </object>
    </property>
  </template>
</interface>
