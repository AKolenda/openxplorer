<?xml version="1.0" encoding="UTF-8"?>
<!-- SPDX-License-Identifier: AGPL-3.0-only -->
<!--
  "Open with": `openWithDialog` of v2.0.0:desktop/ui/app.js in the app's modal
  dialog frame (native/docs/ui-spec.md §4.11): the item's name, "Find an
  application", the list of installed applications, "Show all installed
  applications", "Always use this app for this file type", a status line,
  then Cancel and Open. src/integration/open_with_dialog.rs fills the list.
-->
<interface>
  <requires lib="gtk" version="4.14"/>
  <template class="OxOpenWithDialog" parent="GtkWindow">
    <property name="title" translatable="yes">Open with</property>
    <property name="modal">true</property>
    <property name="resizable">false</property>
    <property name="destroy-with-parent">true</property>
    <property name="default-width">510</property>
    <property name="titlebar">
      <object class="GtkBox">
        <property name="visible">false</property>
      </object>
    </property>
    <property name="accessible-role">dialog</property>
    <style>
      <class name="ox"/>
      <class name="ox-dialog"/>
    </style>
    <property name="child">
      <object class="GtkWindowHandle">
        <property name="child">
          <object class="GtkBox">
            <property name="orientation">vertical</property>
            <child>
              <!-- The body scrolls when the dialog would be taller than its
                   window (src/modal.rs); otherwise it is as tall as its content. -->
              <object class="GtkScrolledWindow" id="scroller">
                <property name="hscrollbar-policy">never</property>
                <property name="propagate-natural-width">true</property>
                <property name="propagate-natural-height">true</property>
                <property name="vexpand">true</property>
                <property name="child">
                  <object class="GtkBox">
                    <property name="orientation">vertical</property>
                    <style>
                      <class name="dialog-content"/>
                    </style>
                    <child>
                      <object class="GtkLabel" id="i18n_1">
                        <property name="label" translatable="yes">Open with</property>
                        <property name="xalign">0</property>
                        <style>
                          <class name="dialog-title"/>
                        </style>
                      </object>
                    </child>
                    <child>
                      <!-- The item, as the Python dialog's description. -->
                      <object class="GtkLabel" id="item_label">
                        <property name="xalign">0</property>
                        <property name="ellipsize">middle</property>
                        <style>
                          <class name="dialog-message"/>
                        </style>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel" id="i18n_2">
                        <property name="label" translatable="yes">Find an application</property>
                        <property name="xalign">0</property>
                        <property name="mnemonic-widget">filter_entry</property>
                        <style>
                          <class name="field-label"/>
                        </style>
                      </object>
                    </child>
                    <child>
                      <object class="GtkEntry" id="filter_entry">
                        <property name="placeholder-text" translatable="yes">Search installed applications</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkScrolledWindow">
                        <property name="hscrollbar-policy">never</property>
                        <property name="min-content-height">240</property>
                        <property name="max-content-height">240</property>
                        <property name="margin-top">12</property>
                        <style>
                          <class name="app-choices"/>
                        </style>
                        <property name="child">
                          <object class="GtkListBox" id="application_list">
                            <property name="selection-mode">single</property>
                            <accessibility>
                              <property name="label" translatable="yes">Installed applications</property>
                            </accessibility>
                          </object>
                        </property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkCheckButton" id="show_all_check">
                        <property name="label" translatable="yes">Show all installed applications</property>
                        <style>
                          <class name="dialog-check"/>
                        </style>
                      </object>
                    </child>
                    <child>
                      <object class="GtkCheckButton" id="make_default_check">
                        <property name="label" translatable="yes">Always use this app for this file type</property>
                        <style>
                          <class name="dialog-check"/>
                        </style>
                      </object>
                    </child>
                    <child>
                      <!-- A command line instead of an application (OPEN-014). -->
                      <object class="GtkLabel" id="i18n_3">
                        <property name="label" translatable="yes">Or run a command</property>
                        <property name="xalign">0</property>
                        <property name="mnemonic-widget">command_entry</property>
                        <style>
                          <class name="field-label"/>
                        </style>
                      </object>
                    </child>
                    <child>
                      <object class="GtkEntry" id="command_entry">
                        <property name="placeholder-text" translatable="yes">Such as gimp %f (%f is the file, %u its address)</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkCheckButton" id="terminal_check">
                        <property name="label" translatable="yes">Run in terminal</property>
                        <style>
                          <class name="dialog-check"/>
                        </style>
                      </object>
                    </child>
                    <child>
                      <object class="GtkCheckButton" id="keep_open_check">
                        <property name="label" translatable="yes">Keep the terminal open when the command ends</property>
                        <property name="sensitive">false</property>
                        <style>
                          <class name="dialog-check"/>
                        </style>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel" id="status_label">
                        <property name="label" translatable="yes">Loading…</property>
                        <property name="xalign">0</property>
                        <property name="wrap">true</property>
                        <property name="max-width-chars">60</property>
                        <property name="accessible-role">status</property>
                        <style>
                          <class name="dialog-hint"/>
                        </style>
                      </object>
                    </child>
                  </object>
                </property>
              </object>
            </child>
            <child>
              <object class="GtkBox">
                <style>
                  <class name="dialog-actions"/>
                </style>
                <child>
                  <object class="GtkBox">
                    <property name="hexpand">true</property>
                    <property name="halign">end</property>
                    <property name="spacing">8</property>
                    <child>
                      <object class="GtkButton" id="cancel_button">
                        <property name="label" translatable="yes">Cancel</property>
                        <style>
                          <class name="bordered"/>
                          <class name="dialog-button"/>
                        </style>
                      </object>
                    </child>
                    <child>
                      <object class="GtkButton" id="open_button">
                        <property name="label" translatable="yes">Open</property>
                        <property name="sensitive">false</property>
                        <style>
                          <class name="accent"/>
                          <class name="dialog-button"/>
                        </style>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </property>
      </object>
    </property>
  </template>
</interface>
