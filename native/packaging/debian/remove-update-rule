# The stable package's postrm only, ahead of the cache refreshes: removing
# or purging the package deletes the polkit rule and the record of the
# setting "Install updates without asking for a password"
# (crates/ox-core/src/update/passwordless.rs and install-update-rule), so
# no rule that skips the password outlives the package. An upgrade keeps
# them, and so keeps the user's choice. rm never follows a link it is
# given.
case "$1" in
    remove|purge)
        # A helper still changing the setting finishes first, so it cannot
        # write the rule back after this.
        lock="$DPKG_ROOT/var/cache/openxplorer-update"
        if [ -d "$lock" ] && command -v flock >/dev/null 2>&1; then
            exec 9<"$lock"
            flock -w 30 9 || true
        fi
        rm -f "$DPKG_ROOT/etc/polkit-1/rules.d/60-io.winspace.Development.install-update.rules"
        rm -f "$DPKG_ROOT/var/lib/openxplorer/install-updates-without-password"
        rmdir "$DPKG_ROOT/var/lib/openxplorer" 2>/dev/null || true
        ;;
esac

