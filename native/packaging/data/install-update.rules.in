// SPDX-License-Identifier: AGPL-3.0-only
//
// Lets an administrator at the machine install an OpenXplorer update
// without a password, as Ubuntu's Software lets them install system
// updates. It covers one action only, @ACTION_ID@, whose program is the
// update helper: the helper takes only a version and installs nothing but
// the latest official release, verified, and only when it is newer than
// the installed package (crates/ox-core/src/update/install_helper.rs).
//
// Only a member of sudo, admin or wheel in a local, active session gets
// through. Anyone else, and any remote or inactive session, is asked for
// an administrator's password by the action's own defaults.
//
// It is off by default. The package installs this rule only as a template,
// /usr/share/openxplorer/install-update.rules, which polkit does not read.
// Turning on "Install updates without asking for a password" in
// OpenXplorer's Settings copies it to
// /etc/polkit-1/rules.d/60-@ACTION_ID@.rules, after an administrator's
// password; turning it off, or removing the package, deletes that copy.
polkit.addRule(function (action, subject) {
    if (action.id !== "@ACTION_ID@") {
        return polkit.Result.NOT_HANDLED;
    }
    if (!subject.local || !subject.active) {
        return polkit.Result.NOT_HANDLED;
    }
    if (subject.isInGroup("sudo") || subject.isInGroup("admin") || subject.isInGroup("wheel")) {
        return polkit.Result.YES;
    }
    return polkit.Result.NOT_HANDLED;
});
