# tools/release.py leaves the same paths out of the corresponding-source
# archive; tests/test_release_source.py checks that the two agree.

# Dependencies, build caches and compiled Python bytecode.
node_modules/
.next/
out/
.pnpm-store/
*.tsbuildinfo
__pycache__/
*.py[cod]

# Local secrets. The examples hold only public placeholders and are published.
.env*
!.env.example
.dev.vars*
!.dev.vars.example

# Deployment tool state, other version-control systems and macOS metadata.
.wrangler/
.vercel/
.hg/
.svn/
.DS_Store

# Build and release output, and files regenerated from their sources.
dist/
desktop/dist/
designs/
apps/web/public/downloads/
apps/web/public/app-preview.html
apps/web/public/assets/site.js
desktop/preview.html

# Local tools, runtime data and test captures are not editable release inputs.
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.cache/
.tox/
.nox/
.hypothesis/
.nyc_output/
.coverage*
htmlcov/
coverage/
