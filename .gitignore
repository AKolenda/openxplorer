# tools/release.py leaves these paths out of the corresponding-source archive
# too. It matches file names case-insensitively, so it also leaves out
# upper-case variants such as PRIVATE.KEY, which Git ignores only when
# core.ignorecase is set. tests/test_release_source.py checks that Git and the
# archive agree on a sample of paths.

# Dependencies, package-manager stores, TypeScript build info and compiled
# Python bytecode.
node_modules/
.pnpm-store/
*.tsbuildinfo
__pycache__/
*.py[cod]

# Local secrets: environment files, private keys, certificates and credential
# files. The .example files hold only public placeholders and are published.
.env*
!.env.example
.dev.vars*
!.dev.vars.example
*.pem
*.key
*.p12
*.pfx
*.credentials
credentials.json
credentials.toml
credentials.yaml
credentials.yml
client_secret*.json
service-account*.json

# Deployment tool state, other version-control systems and macOS metadata.
.wrangler/
.vercel/
.hg/
.svn/
.DS_Store

# Build and release output, and files regenerated from their sources.
# .next/ and out/ hold the Next.js website build and its static export.
# dist/ matches at any depth, so it covers desktop/dist/ as well.
.next/
out/
dist/
designs/
apps/web/public/downloads/
apps/web/public/app-preview.html
apps/web/public/assets/site.js
desktop/preview.html

# Built packages and archives, in any directory.
*.deb
*.zip

# Virtual environments, tool caches and coverage data.
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.cache/
.tox/
.nox/
.hypothesis/
.nyc_output/
.coverage*
htmlcov/
coverage/

# Scratch directories, test results and test captures.
tmp/
.tmp/
temp/
.temp/
test-results/
playwright-report/
blob-report/

# Logs and local databases.
*.log
*.log.*
*.sqlite
*.sqlite-*
*.sqlite3
*.sqlite3-*
*.db
*.db-*

# Editor swap files, backups and temporary files.
*.swp
*.swo
*.tmp
*.temp
*~

# Local privacy-review identifiers must never be published.
.private-demo-terms*
private-terms.json

# Rust build output.
native/target/
